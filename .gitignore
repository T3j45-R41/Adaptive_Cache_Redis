# =============================================================================
# Git Ignore Configuration: Adaptive Cache Redis & MySQL Analytics
# =============================================================================

# Environments & Secret Keys
.env
.env.local
.env.*.local

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
*.sqlite3-journal

# Node & Frontend dependencies & bundles
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# C++ compiled binaries & object files
*.o
*.obj
*.exe
*.out
Redis-Server/my_redis_server
Redis-Server/my_redis_server.exe
Redis-Server/dump.my_rdb
dump.my_rdb

# Logs & temp files
*.log
temp/
tmp/

# OS & Editor generated files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

