# =============================================================================
# Adaptive Cache Redis & MySQL Environment Configuration
# =============================================================================

# C++ In-Memory Redis Server Connection
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Relational DBMS (MySQL 8.x) Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_root_password
MYSQL_DATABASE=adaptive_cache_db

# Backend FastAPI Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Benchmark & Workload Settings
DEFAULT_CACHE_CAPACITY=500
DEFAULT_EVICTION_POLICY=ADAPTIVE
DEFAULT_WORKLOAD=zipfian
STALENESS_THRESHOLD_SECONDS=5.0
